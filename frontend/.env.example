# Copy to .env.local. Only public values belong here — everything prefixed VITE_ ships to the browser.
# Supabase project URL (hosted: https://<project-ref>.supabase.co, local CLI: http://127.0.0.1:54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The publishable/anon key. NEVER put the service-role or secret key here.
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# ASP.NET Core API base URL
VITE_API_BASE_URL=http://localhost:5080
