# Backend configuration via environment variables (ASP.NET Core uses "__" for nesting).
# In development you can instead use `dotnet user-secrets` (UserSecretsId: bouldertime-api).
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL. Local Supabase CLI default shown. For hosted Supabase use the direct or session-pooler
# connection string from Project Settings > Database (NOT the transaction pooler, which breaks migrations).
ConnectionStrings__Database=Host=127.0.0.1;Port=54322;Database=postgres;Username=postgres;Password=postgres

# Supabase project URL. Tokens are verified against {Url}/auth/v1/.well-known/jwks.json.
Supabase__Url=http://127.0.0.1:54321
# Optional: legacy HS256 JWT secret, only if your project still signs sessions symmetrically. SERVER-ONLY.
Supabase__JwtSecret=

# Comma-free list; add one variable per origin.
Cors__AllowedOrigins__0=http://localhost:5173

# Phase 3+: storage access from the server. SERVER-ONLY — never ship to the frontend.
# Supabase__ServiceRoleKey=
